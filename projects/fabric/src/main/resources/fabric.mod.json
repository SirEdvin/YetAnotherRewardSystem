{
  "schemaVersion": 1,
  "id": "yars",
  "version": "${version}",
  "name": "Yet Another Reward System",
  "description": "A KubeJS extension point for reward systems.",
  "authors": [
    "SirEdvin"
  ],
  "accessWidener": "yars.accesswidener",
  "contact": {
    "homepage": "https://github.com/SirEdvin/YetAnotherRewardSystem/",
    "issues": "https://github.com/SirEdvin/YetAnotherRewardSystem/issues",
    "sources": "https://github.com/SirEdvin/YetAnotherRewardSystem/"
  },
  "license": "MIT",
  "icon": "pack.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "site.siredvin.yars.YarsFabric"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "site.siredvin.yars.YarsFabricClient"
      }
    ]
  },
  "mixins": [
    "yars.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.13.3",
    "fabric": "*",
    "minecraft": ">=1.20 <1.21",
    "java": ">=17",
    "broccolium": ">=${broccoliumVersion}",
    "kubejs": ">=2001.6.5-build.20"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/dYHKMQYRPp"
      }
    }
  }
}
